# ──────────────────────────────────────────────────────────────────────────────
# Fazoo root environment template — copy to .env and fill in.
# NEVER commit real keys. The service-role key is server-side ONLY
# (Next.js route handlers / Supabase functions). Never in the browser or app.
# ──────────────────────────────────────────────────────────────────────────────

# Supabase project: FAZOO (`lcptkprosdmprizvsgsp`).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mobile app mirrors the same project (Expo env prefix)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin portal — absolute URL used for auth redirects in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: short-lived signed photo URLs in admin views (default: off)
ADMIN_SIGNED_PHOTO_URLS=false
ADMIN_SIGNED_URL_TTL_SECONDS=300

# Supabase CLI personal access token (supabase.com/dashboard/account/tokens).
# Used locally for `supabase db push` / `supabase gen types typescript`.
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token

# ──────────────────────────────────────────────────────────────────────────────
# Booklist document conversion (image / PDF → editable Word draft).
# DOCUMENT_AI_PROVIDER: azure | none | manual   (default: azure when configured)
# "manual" keeps every upload in the admin conversion queue with no OCR call.
# ──────────────────────────────────────────────────────────────────────────────
DOCUMENT_AI_PROVIDER=azure
AZURE_DOCUMENT_AI_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
AZURE_DOCUMENT_AI_KEY=your-azure-document-ai-key
AZURE_DOCUMENT_AI_API_VERSION=2024-11-30
AZURE_DOCUMENT_AI_MODEL=prebuilt-document
AZURE_DOCUMENT_AI_RESOURCE_PATH=documentintelligence
AZURE_DOCUMENT_AI_TIMEOUT_MS=60000

# Below this mean confidence the draft is still stored but flagged for a human.
OCR_MIN_CONFIDENCE=60
