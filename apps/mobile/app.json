{
  "expo": {
    "name": "Fazoo",
    "slug": "fazoo",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "fazoo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.fazoo.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Fazoo uses your location to verify you are at your assigned store during check-in and checkout.",
        "NSCameraUsageDescription": "Fazoo uses the camera for your uniform selfie and stock-on-shelf photos.",
        "NSPhotoLibraryUsageDescription": "Fazoo can attach an existing photo if camera capture is not possible."
      }
    },
    "android": {
      "package": "app.fazoo.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0F"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-file-system",
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c9289e63-d3a0-4120-b5b3-02c24f454f4f"
      }
    },
    "owner": "izuafrica"
  }
}
