# Local-stack e2e env for the admin portal — placeholders only; never commit real values.
# Copy to apps/admin/.env.e2e.local (gitignored) before running `pnpm test:e2e:local`.
# The anon key comes from `cd supabase && supabase start` stdout (anonymous key / anon key).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed demo users (see supabase/seed.sql); swap for hosted accounts to run the
# e2e suite against a remote project instead.
E2E_ADMIN_PHONE=super.admin.demo@ba.fazoo.app
E2E_ADMIN_PASSWORD=Demo-Super1!
E2E_ORG_ADMIN_PHONE=org.admin.demo@ba.fazoo.app
E2E_ORG_ADMIN_PASSWORD=Demo-Admin1!
E2E_BA_PHONE=ba.one.demo@ba.fazoo.app
E2E_BA_PASSWORD=Demo-Ba#001!

PLAYWRIGHT_BASE_URL=http://localhost:3000