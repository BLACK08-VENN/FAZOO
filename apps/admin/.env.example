# Admin portal environment — placeholders only; never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Playwright e2e credentials (optional). When unset, local runs fall back to
# the supabase/seed.sql demo users; point these at real accounts to run the
# suite against a hosted project.
# E2E_ADMIN_PHONE=super.admin.demo@ba.fazoo.app
# E2E_ADMIN_PASSWORD=Demo-Super1!
# E2E_ORG_ADMIN_PHONE=org.admin.demo@ba.fazoo.app
# E2E_ORG_ADMIN_PASSWORD=Demo-Admin1!
# E2E_BA_PHONE=ba.one.demo@ba.fazoo.app
# E2E_BA_PASSWORD=Demo-Ba#001!
