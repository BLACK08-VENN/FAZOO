{{page-title 'Fazoo — Login'}}

<div class='min-vh-100 d-flex align-items-center justify-content-center py-4' style='background: linear-gradient(160deg, #5A1E82 0%, #7B2FBE 100%)'>
  <div class='card shadow-lg mx-3' style='width: 100%; max-width: {{if this.isRegistering "520px" "400px"}}'>
    <div class='card-body p-4 p-sm-5'>

      {{! ── Brand header ── }}
      <div class='text-center mb-4'>
        <div class="rounded-2 p-0 bg-white mx-auto" style="width:180px; height:180px">
          <img src="/favicon.png" class="w-100 rounded-2 ratio ratio-1x1" />
        </div>
        <h1 class='display-6 fw-bold text-primary my-3'>Fazoo</h1>
        <p class='text-muted small'>
          VEDA Activation —
          {{#if this.isForgotPassword}}
            Reset Password
          {{else}}
            BA {{if this.isRegistering "Registration" "Login"}}
          {{/if}}
        </p>
      </div>

      {{! ── Tab switcher (hidden on forgot-password panel) ── }}
      {{#unless this.isForgotPassword}}
        <div class='d-flex rounded-2 overflow-hidden border mb-4' style='border-color: #e0d5f5 !important'>
          <button
            type='button'
            class='btn flex-fill rounded-0 fw-semibold {{if this.isRegistering "btn-light text-muted" "btn-primary"}}'
            {{on 'click' this.showLogin}}
          >
            <i class='fa-solid fa-right-to-bracket me-1'></i>Sign In
          </button>
          <button
            type='button'
            class='btn flex-fill rounded-0 fw-semibold {{if this.isRegistering "btn-primary" "btn-light text-muted"}}'
            {{on 'click' this.showRegister}}
          >
            <i class='fa-solid fa-user-plus me-1'></i>Register
          </button>
        </div>
      {{/unless}}

      {{! ── Alerts ── }}
      {{#if this.errorMessage}}
        <div class='alert alert-danger py-2 small'>
          <i class='fa-solid fa-circle-exclamation me-1'></i>{{this.errorMessage}}
        </div>
      {{/if}}
      {{#if this.successMessage}}
        <div class='alert alert-success py-2 small'>
          <i class='fa-solid fa-circle-check me-1'></i>{{this.successMessage}}
        </div>
      {{/if}}

      {{! ════════════════════════════════════════ }}
      {{! ── FORGOT-PASSWORD PANEL ── }}
      {{! ════════════════════════════════════════ }}
      {{#if this.isForgotPassword}}

        {{! Step progress indicator }}
        <div class='d-flex align-items-center justify-content-center gap-1 mb-4'>

          <div class='d-flex flex-column align-items-center' style='min-width:56px'>
            <div class='rounded-circle d-flex align-items-center justify-content-center fw-bold mb-1'
                 style={{this.fpCircle1Style}}>1</div>
            <small class='text-muted' style='font-size:10px'>Email</small>
          </div>

          <div class='flex-grow-1 border-top mt-n3' style='border-color:#dee2e6 !important;max-width:32px'></div>

          <div class='d-flex flex-column align-items-center' style='min-width:56px'>
            <div class='rounded-circle d-flex align-items-center justify-content-center fw-bold mb-1'
                 style={{this.fpCircle2Style}}>2</div>
            <small class='text-muted' style='font-size:10px'>OTP</small>
          </div>

          <div class='flex-grow-1 border-top mt-n3' style='border-color:#dee2e6 !important;max-width:32px'></div>

          <div class='d-flex flex-column align-items-center' style='min-width:56px'>
            <div class='rounded-circle d-flex align-items-center justify-content-center fw-bold mb-1'
                 style={{this.fpCircle3Style}}>3</div>
            <small class='text-muted' style='font-size:10px'>Password</small>
          </div>

        </div>

        {{! ── Step 1: Email ─────────────────────── }}
        {{#if (eq this.fpStep this.FP_STEP.EMAIL)}}
          <p class='text-muted small text-center mb-3'>
            Enter the email address linked to your BA account and we'll send you a one-time code.
          </p>
          <div class='mb-3'>
            <label class='form-label fw-medium'>Registered Email Address</label>
            <Input
              class='form-control form-control-lg'
              @type='email'
              @value={{this.fpEmail}}
              placeholder='you@example.com'
              autocomplete='email'
            />
          </div>
          <button
            type='button'
            class='btn btn-primary btn-lg w-100 fw-bold'
            disabled={{this.isBusy}}
            {{on 'click' this.fpRequestOtp}}
          >
            {{#if this.isBusy}}
              <span class='spinner-border spinner-border-sm me-2'></span>Sending OTP…
            {{else}}
              <i class='fa-solid fa-paper-plane me-2'></i>Send OTP
            {{/if}}
          </button>
        {{/if}}

        {{! ── Step 2: OTP ───────────────────────── }}
        {{#if (eq this.fpStep this.FP_STEP.OTP)}}
          <p class='text-muted small text-center mb-3'>
            Check your inbox at <strong>{{this.fpEmail}}</strong> for a 6-digit code.
          </p>
          <div class='mb-3'>
            <label class='form-label fw-medium'>6-Digit OTP</label>
            <Input
              class='form-control form-control-lg text-center fw-bold'
              @type='text'
              @value={{this.fpOtp}}
              placeholder='_ _ _ _ _ _'
              maxlength='6'
              autocomplete='one-time-code'
              inputmode='numeric'
            />
          </div>
          <button
            type='button'
            class='btn btn-primary btn-lg w-100 fw-bold'
            disabled={{this.isBusy}}
            {{on 'click' this.fpVerifyOtp}}
          >
            {{#if this.isBusy}}
              <span class='spinner-border spinner-border-sm me-2'></span>Verifying…
            {{else}}
              <i class='fa-solid fa-shield me-2'></i>Verify OTP
            {{/if}}
          </button>
          <div class='text-center mt-3'>
            {{#if this.canResend}}
              <button type='button' class='btn btn-link btn-sm text-primary p-0' {{on 'click' this.fpResendOtp}}>
                <i class='fa-solid fa-rotate-right me-1'></i>Resend OTP
              </button>
            {{else}}
              <small class='text-muted'>
                Resend available in <strong>{{this.fpResendCooldown}}s</strong>
              </small>
            {{/if}}
          </div>
        {{/if}}

        {{! ── Step 3: New password ──────────────── }}
        {{#if (eq this.fpStep this.FP_STEP.PASSWORD)}}
          <p class='text-muted small text-center mb-3'>
            OTP verified! Choose a new password for your account.
          </p>
          <div class='mb-3'>
            <label class='form-label fw-medium'>New Password</label>
            <Input
              class='form-control form-control-lg'
              @type='password'
              @value={{this.fpNewPassword}}
              placeholder='At least 6 characters'
              autocomplete='new-password'
            />
          </div>
          <div class='mb-4'>
            <label class='form-label fw-medium'>Confirm New Password</label>
            <Input
              class='form-control form-control-lg'
              @type='password'
              @value={{this.fpConfirmPass}}
              placeholder='Repeat your new password'
              autocomplete='new-password'
            />
            {{#if this.fpPasswordMismatch}}
              <div class='form-text text-danger'>Passwords don't match</div>
            {{/if}}
          </div>
          <button
            type='button'
            class='btn btn-primary btn-lg w-100 fw-bold'
            disabled={{or this.isBusy this.fpPasswordMismatch}}
            {{on 'click' this.fpResetPassword}}
          >
            {{#if this.isBusy}}
              <span class='spinner-border spinner-border-sm me-2'></span>Saving…
            {{else}}
              <i class='fa-solid fa-lock me-2'></i>Set New Password
            {{/if}}
          </button>
        {{/if}}

        {{! ── Step 4: Done ─────────────────────── }}
        {{#if (eq this.fpStep this.FP_STEP.DONE)}}
          <div class='text-center py-3'>
            <i class='fa-solid fa-circle-check fa-3x text-success mb-3'></i>
            <h5 class='fw-bold'>Password Updated!</h5>
            <p class='text-muted small'>You can now sign in with your new password.</p>
          </div>
        {{/if}}

        {{! Back to login link }}
        <div class='text-center mt-4'>
          <button type='button' class='btn btn-link btn-sm text-muted p-0' {{on 'click' this.showLogin}}>
            <i class='fa-solid fa-arrow-left me-1'></i>Back to Sign In
          </button>
        </div>

      {{/if}}{{! /isForgotPassword }}

      {{! ════════════════════════════════════════ }}
      {{! ── LOGIN FORM ── }}
      {{! ════════════════════════════════════════ }}
      {{#unless this.isRegistering}}
        {{#unless this.isForgotPassword}}
          <div class='mb-3'>
            <label class='form-label fw-medium'>Mobile Number</label>
            <Input
              class='form-control form-control-lg'
              @type='tel'
              @value={{this.phone}}
              placeholder='e.g. 4712345678'
              autocomplete='tel'
            />
          </div>

          <div class='mb-3'>
            <label class='form-label fw-medium'>Password</label>
            <Input
              class='form-control form-control-lg'
              @type='password'
              @value={{this.password}}
              placeholder='Your password'
              autocomplete='current-password'
            />
          </div>

          <div class='mb-3 d-flex justify-content-between align-items-center'>
            <div class='form-check mb-0'>
              <Input
                class='form-check-input'
                @type='checkbox'
                @checked={{this.rememberMe}}
                id='rememberMe'
              />
              <label class='form-check-label text-muted small' for='rememberMe'>
                Remember me on this device
              </label>
            </div>
            <button
              type='button'
              class='btn btn-link btn-sm text-primary p-0 small'
              {{on 'click' this.showForgotPassword}}
            >
              Forgot password?
            </button>
          </div>

          <button
            type='button'
            class='btn btn-primary btn-lg w-100 fw-bold'
            disabled={{or this.isBusy this.isUploadingPhoto}}
            {{on 'click' this.login}}
          >
            {{#if this.isBusy}}
              <span class='spinner-border spinner-border-sm me-2'></span>Signing in…
            {{else}}
              <i class='fa-solid fa-right-to-bracket me-2'></i>Sign In
            {{/if}}
          </button>

          <div class='text-center mt-4'>
            <small class='text-muted'>Admin?
              <a href='/admin/login' class='text-primary fw-medium'>Admin Portal →</a>
            </small>
          </div>
        {{/unless}}
      {{/unless}}

      {{! ════════════════════════════════════════ }}
      {{! ── REGISTRATION FORM ── }}
      {{! ════════════════════════════════════════ }}
      {{#if this.isRegistering}}
        <div class='row g-3'>

          {{! Full name }}
          <div class='col-12'>
            <label class='form-label fw-medium'>Full Name <span class='text-danger'>*</span></label>
            <Input
              class='form-control'
              @type='text'
              @value={{this.reg.name}}
              placeholder='As on your ID'
              autocomplete='name'
            />
          </div>

          {{! Phone (×2) }}
          <div class='col-sm-6'>
            <label class='form-label fw-medium'>Mobile Number <span class='text-danger'>*</span></label>
            <Input
              class='form-control'
              @type='tel'
              @value={{this.reg.phone}}
              placeholder='e.g. 9876543210'
              autocomplete='tel'
            />
          </div>
          <div class='col-sm-6'>
            <label class='form-label fw-medium'>Confirm Mobile <span class='text-danger'>*</span></label>
            <Input
              class='form-control'
              @type='tel'
              @value={{this.reg.phoneConfirm}}
              placeholder='Re-enter number'
              autocomplete='off'
            />
            {{#if this.phoneMismatch}}
              <div class='form-text text-danger'>Numbers don't match</div>
            {{/if}}
          </div>

          {{! Password }}
          <div class='col-12'>
            <label class='form-label fw-medium'>Password <span class='text-danger'>*</span></label>
            <Input
              class='form-control'
              @type='password'
              @value={{this.reg.password}}
              placeholder='Choose a strong password'
              autocomplete='new-password'
            />
            <div class='form-text text-muted'>
              Can't change this yourself — contact us on WhatsApp if needed.
            </div>
          </div>

          {{! Email }}
          <div class='col-12'>
            <label class='form-label fw-medium'>Email Address <span class='text-danger'>*</span></label>
            <Input
              class='form-control'
              @type='email'
              @value={{this.reg.email}}
              placeholder='you@example.com'
              autocomplete='email'
            />
          </div>

          {{! Gender }}
          <div class='col-sm-6'>
            <label class='form-label fw-medium'>Gender <span class='text-danger'>*</span></label>
            <select class='form-select' {{on 'change' this.setGender}}>
              <option value=''>— Select —</option>
              <option value='male'   selected={{eq this.reg.gender 'male'}}>Male</option>
              <option value='female' selected={{eq this.reg.gender 'female'}}>Female</option>
              <option value='other'  selected={{eq this.reg.gender 'other'}}>Other</option>
            </select>
          </div>

          {{! Age }}
          <div class='col-sm-6'>
            <label class='form-label fw-medium'>Age <span class='text-danger'>*</span></label>
            <Input
              class='form-control'
              @type='number'
              @value={{this.reg.age}}
              placeholder='e.g. 24'
              min='18'
              max='60'
            />
          </div>

          {{! City }}
          <div class='col-12'>
            <label class='form-label fw-medium'>City <span class='text-danger'>*</span></label>
            <Input
              class='form-control'
              @type='text'
              @value={{this.reg.city}}
              placeholder='Your city'
              autocomplete='address-level2'
            />
          </div>

          {{! Photo upload }}
          <div class='col-12'>
            <label class='form-label fw-medium'>Profile Photo <span class='text-danger'>*</span></label>

            {{#if this.photoUploadError}}
              <div class='alert alert-danger py-2 small mb-2'>
                <i class='fa-solid fa-circle-exclamation me-1'></i>{{this.photoUploadError}}
              </div>
            {{/if}}

            <div
              class='rounded-2 border border-2 d-flex flex-column align-items-center justify-content-center p-3 text-center {{if this.isUploadingPhoto "opacity-75"}}'
              style='border-color: #c4aee8 !important; border-style: dashed !important; cursor: pointer; min-height: 120px; background: #faf7ff;'
              {{on 'click' this.triggerPhotoInput}}
            >
              {{#if this.isUploadingPhoto}}
                <span class='spinner-border text-primary mb-2' role='status' aria-hidden='true'></span>
                <small class='text-muted'>Uploading…</small>
              {{else if this.photoPreview}}
                <img
                  src={{this.photoPreview}}
                  alt='Preview'
                  class='rounded-circle mb-2 object-fit-cover'
                  style='width: 80px; height: 80px;'
                />
                {{#if this.reg.photoUrl}}
                  <small class='text-muted'>{{this.reg.photoName}}</small>
                  <small class='text-success mt-1'><i class='fa-solid fa-circle-check me-1'></i>Uploaded</small>
                {{/if}}
                <small class='text-primary mt-1' style='cursor:pointer'>Change photo</small>
              {{else}}
                <i class='fa-solid fa-camera fa-2x text-primary mb-2'></i>
                <span class='fw-medium text-dark small'>Click to upload your photo</span>
                <small class='text-muted'>JPG or PNG, clear face shot</small>
              {{/if}}
            </div>
            <input
              type='file'
              accept='image/jpeg,image/png'
              class='d-none'
              id='photoInput'
              disabled={{this.isUploadingPhoto}}
              {{on 'change' this.onPhotoSelected}}
            />
          </div>

        </div>{{! /row }}

        <button
          type='button'
          class='btn btn-primary btn-lg w-100 fw-bold mt-4'
          disabled={{this.isBusy}}
          {{on 'click' this.register}}
        >
          {{#if this.isBusy}}
            <span class='spinner-border spinner-border-sm me-2'></span>Creating account…
          {{else}}
            <i class='fa-solid fa-user-plus me-2'></i>Create Account
          {{/if}}
        </button>

        <p class='text-center text-muted small mt-3 mb-0'>
          All fields marked <span class='text-danger'>*</span> are required.
          To change your password later, reach us on the BA WhatsApp group.
        </p>
      {{/if}}

    </div>
  </div>
</div>
