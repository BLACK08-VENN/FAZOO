{{page-title "Fazoo — Lenovo Login"}}

<div
  class="min-vh-100 d-flex align-items-center justify-content-center py-4"
  style="background: linear-gradient(160deg, #5A1E82 0%, #7B2FBE 100%)"
>
  <div
    class="card shadow-lg mx-3"
    style="width: 100%; max-width: {{if this.isRegistering '560px' '400px'}}"
  >
    <div class="card-body p-4 p-sm-5">

      {{! ── Brand header ── }}
      <div class="text-center mb-4">
        <div
          class="rounded-2 p-0 bg-white mx-auto"
          style="width:180px; height:180px"
        >
          <img
            src="/favicon.png"
            class="w-100 rounded-2 ratio ratio-1x1"
            alt="Fazoo"
          />
        </div>
        <h1 class="display-6 fw-bold text-primary my-3">Fazoo</h1>
        <p class="text-muted small">LENOVO Activation — BA
          {{if this.isRegistering "Registration" "Login"}}</p>
      </div>

      {{! ── Tab switcher ── }}
      <div
        class="d-flex rounded-2 overflow-hidden border mb-4"
        style="border-color: #e0d5f5 !important"
      >
        <button
          type="button"
          class="btn flex-fill rounded-0 fw-semibold
            {{if
              this.isRegistering
              'btn-light text-muted'
              'btn-primary'
            }}"
          {{on "click" this.showLogin}}
        >
          <i class="fa-solid fa-right-to-bracket me-1"></i>Sign In
        </button>
        <button
          type="button"
          class="btn flex-fill rounded-0 fw-semibold
            {{if this.isRegistering 'btn-primary' 'btn-light text-muted'}}"
          {{on "click" this.showRegister}}
        >
          <i class="fa-solid fa-user-plus me-1"></i>Register
        </button>
      </div>

      {{! ── Alerts ── }}
      {{#if this.errorMessage}}
        <div class="alert alert-danger py-2 small">
          <i
            class="fa-solid fa-circle-exclamation me-1"
          ></i>{{this.errorMessage}}
        </div>
      {{/if}}
      {{#if this.successMessage}}
        <div class="alert alert-success py-2 small">
          <i class="fa-solid fa-circle-check me-1"></i>{{this.successMessage}}
        </div>
      {{/if}}

      {{! ════════════════════════════════════════ }}
      {{! ── LOGIN FORM ── }}
      {{! ════════════════════════════════════════ }}
      {{#unless this.isRegistering}}
        <div class="mb-3">
          <label class="form-label fw-medium">Mobile Number</label>
          <Input
            class="form-control form-control-lg"
            @type="tel"
            @value={{this.phone}}
            placeholder="e.g. 9876543210"
            autocomplete="tel"
          />
        </div>

        <div class="mb-3">
          <label class="form-label fw-medium">Password</label>
          <Input
            class="form-control form-control-lg"
            @type="password"
            @value={{this.password}}
            placeholder="Your password"
            autocomplete="current-password"
          />
        </div>

        <div class="mb-4 form-check">
          <Input
            class="form-check-input"
            @type="checkbox"
            @checked={{this.rememberMe}}
            id="lenovoRememberMe"
          />
          <label
            class="form-check-label text-muted small"
            for="lenovoRememberMe"
          >
            Remember me on this device
          </label>
        </div>

        <button
          type="button"
          class="btn btn-primary btn-lg w-100 fw-bold"
          disabled={{this.isBusy}}
          {{on "click" this.login}}
        >
          {{#if this.isBusy}}
            <span class="spinner-border spinner-border-sm me-2"></span>Signing
            in…
          {{else}}
            <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
          {{/if}}
        </button>
      {{/unless}}

      {{! ════════════════════════════════════════ }}
      {{! ── REGISTRATION FORM ── }}
      {{! ════════════════════════════════════════ }}
      {{#if this.isRegistering}}
        <div class="row g-3">

          {{! Full name }}
          <div class="col-12">
            <label class="form-label fw-medium">Full Name
              <span class="text-danger">*</span></label>
            <Input
              class="form-control"
              @type="text"
              @value={{this.reg.name}}
              placeholder="As on your ID"
              autocomplete="name"
            />
          </div>

          {{! Phone (×2) }}
          <div class="col-sm-6">
            <label class="form-label fw-medium">Mobile Number
              <span class="text-danger">*</span></label>
            <Input
              class="form-control"
              @type="tel"
              @value={{this.reg.phone}}
              placeholder="e.g. 9876543210"
              autocomplete="tel"
            />
          </div>
          <div class="col-sm-6">
            <label class="form-label fw-medium">Confirm Mobile
              <span class="text-danger">*</span></label>
            <Input
              class="form-control"
              @type="tel"
              @value={{this.reg.phoneConfirm}}
              placeholder="Re-enter number"
              autocomplete="off"
            />
            {{#if this.phoneMismatch}}
              <div class="form-text text-danger">Numbers don't match</div>
            {{/if}}
          </div>

          {{! Password }}
          <div class="col-12">
            <label class="form-label fw-medium">Password
              <span class="text-danger">*</span></label>
            <Input
              class="form-control"
              @type="password"
              @value={{this.reg.password}}
              placeholder="Choose a strong password"
              autocomplete="new-password"
            />
            <div class="form-text text-muted">
              Can't change this yourself — contact us on WhatsApp if needed.
            </div>
          </div>

          {{#if this.uploadError}}
            <div class="col-12">
              <div class="alert alert-danger py-2 small mb-0">
                <i
                  class="fa-solid fa-circle-exclamation me-1"
                ></i>{{this.uploadError}}
              </div>
            </div>
          {{/if}}

          {{! ── Profile photo ── }}
          <div class="col-12">
            <label class="form-label fw-medium">Profile Photo
              <span class="text-danger">*</span></label>
            <div
              class="rounded-2 border border-2 d-flex flex-column align-items-center justify-content-center p-3 text-center"
              style="border-color: #c4aee8 !important; border-style: dashed !important; cursor: pointer; min-height: 120px; background: #faf7ff;"
              {{on "click" (fn this.triggerFileInput "photo")}}
            >
              {{#if (eq this.uploadingSlot "photo")}}
                <span
                  class="spinner-border text-primary mb-2"
                  role="status"
                  aria-hidden="true"
                ></span>
                <small class="text-muted">Uploading…</small>
              {{else if this.photoPreview}}
                <img
                  src={{this.photoPreview}}
                  alt="Profile preview"
                  class="rounded-circle mb-2 object-fit-cover"
                  style="width: 80px; height: 80px;"
                />
                {{#if this.reg.photoUrl}}
                  <small class="text-muted">{{this.reg.photoName}}</small>
                  <small class="text-success mt-1"><i
                      class="fa-solid fa-circle-check me-1"
                    ></i>Uploaded</small>
                {{/if}}
                <small class="text-primary mt-1" style="cursor:pointer">Change
                  photo</small>
              {{else}}
                <i class="fa-solid fa-camera fa-2x text-primary mb-2"></i>
                <span class="fw-medium text-dark small">Click to upload your
                  photo</span>
                <small class="text-muted">JPG or PNG, clear face shot</small>
              {{/if}}
            </div>
            <input
              type="file"
              accept="image/jpeg,image/png"
              class="d-none"
              id="lenovoPhotoInput"
              disabled={{this.isUploading}}
              {{on "change" (fn this.onFileSelected "photo")}}
            />
          </div>

        </div>{{! /row }}

        <button
          type="button"
          class="btn btn-primary btn-lg w-100 fw-bold mt-4"
          disabled={{or this.isBusy this.isUploading}}
          {{on "click" this.register}}
        >
          {{#if this.isBusy}}
            <span class="spinner-border spinner-border-sm me-2"></span>Creating
            account…
          {{else}}
            <i class="fa-solid fa-user-plus me-2"></i>Create Account
          {{/if}}
        </button>

        <p class="text-center text-muted small mt-3 mb-0">
          All fields marked
          <span class="text-danger">*</span>
          are required. To change your password later, reach us on the BA
          WhatsApp group.
        </p>
      {{/if}}

    </div>
  </div>
</div>
