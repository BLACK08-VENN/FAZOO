{{page-title "Index"}}

<div class="container-fluid px-3 pt-4">

  {{! ── Greeting ──────────────────────────────────────────────────────────── }}
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <p class="text-muted mb-0 small">Welcome back,</p>
      <h2 class="fw-bold mb-0">{{@model.ba.modules.title}}</h2>
    </div>
    <button
      type="button"
      class="btn btn-outline-secondary btn-sm"
      {{on "click" this.sessionAuth.logout}}
    >
      Logout
      <i class="fa-solid fa-right-from-bracket"></i>
    </button>
  </div>


  {{! ── All sessions ───────────────────────────────────────────────────────── }}
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h6 class="fw-bold text-muted text-uppercase small mb-0">Sessions <span
      class="badge bg-secondary rounded-pill small mt-n1"
    >{{@model.sessions.length}}</span></h6>
    <LinkTo @route='veda.session' class='btn btn-primary btn-sm fw-bold'>
      <i class='fa-solid fa-plus me-1'></i>New Session
    </LinkTo>
  </div>

  {{#if @model.sessions}}
    <div class="list-group mb-4">
      {{#each @model.sessions as |session|}}
        <div class="list-group-item d-flex justify-content-between align-items-start py-3">
          <div class="me-2">
            <p class="fw-medium mb-0 small">{{session.modules.title}}</p>
            <small class="text-muted">{{format-date
                session.modules.session_date
              }}</small>
            {{#if session.modules.activity_type}}
              <div class="mt-1">
                {{#if (is-array session.modules.activity_type)}}
                  {{#each session.modules.activity_type as |act|}}
                    <span
                      class="badge bg-light text-dark border me-1 small"
                    >{{act}}</span>
                  {{/each}}
                {{else}}
                  <span class="badge bg-light text-dark border me-1 small">
                    {{session.modules.activity_type}}
                  </span>
                {{/if}}
              </div>
            {{/if}}
          </div>

          <div class="text-end flex-shrink-0">
            {{#if session.modules.kissflow_confirmed}}
              <span class="badge bg-success rounded-pill d-block mb-1">
                <i class="fa-solid fa-check me-1"></i>KF Filled
              </span>
            {{else}}
              <span
                class="badge bg-warning text-dark rounded-pill d-block mb-1"
              >
                <i class="fa-solid fa-triangle-exclamation me-1"></i>KF Pending
              </span>
            {{/if}}
            {{#if session.modules.learner_count}}
              <small class="text-muted d-block mb-2">{{session.modules.learner_count}}
                learners</small>
            {{/if}}

            {{! ── Delete button — only for today's sessions ── }}
            {{#if (is-today session.modules.session_date)}}
              <button
                type="button"
                class="btn btn-outline-danger btn-sm"
                {{on "click" (fn this.deleteSession session)}}
              >
                <i class="fa-solid fa-trash me-1"></i>Delete
              </button>
            {{/if}}
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <p class="text-muted small">No sessions yet.</p>
  {{/if}}

</div>

<Footer />
