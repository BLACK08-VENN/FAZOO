{{page-title "Ask Anything — VEDA"}}

<div class="container-fluid px-3 pt-4 pb-5 d-flex flex-column" style="min-height: calc(100dvh - 60px);">

  {{! ── Header ─────────────────────────────────────────────────────────────── }}
  <div class="d-flex align-items-center mb-3">
    <LinkTo @route="veda.index" class="btn btn-link text-muted ps-0 me-2">
      <i class="fa-solid fa-arrow-left"></i>
    </LinkTo>
    <div class="flex-grow-1">
      <h2 class="fw-bold mb-0 lh-1">Ask Anything</h2>
      <p class="text-muted small mb-0">Your VEDA session assistant</p>
    </div>
    {{#if this.hasMessages}}
      <button
        type="button"
        class="btn btn-outline-secondary btn-sm"
        {{on "click" this.clearConversation}}
        title="Clear conversation"
      >
        <i class="fa-solid fa-rotate-right me-1"></i>New Chat
      </button>
    {{/if}}
  </div>

  {{! ── Error banner ────────────────────────────────────────────────────────── }}
  {{#if this.errorMessage}}
    <div class="alert alert-danger py-2 small mb-3" role="alert">
      <i class="fa-solid fa-triangle-exclamation me-1"></i>
      {{this.errorMessage}}
    </div>
  {{/if}}

  {{! ── Message thread ──────────────────────────────────────────────────────── }}
  <div class="flex-grow-1">

    {{#unless this.hasMessages}}
      {{! ── Empty state ───────────────────────────────────────────────────── }}
      <div class="text-center py-5">
        <div
          class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
          style="width:64px;height:64px;background:linear-gradient(135deg,#7b2fbe,#5a1e82);"
        >
          <i class="fa-solid fa-comments text-white fs-4"></i>
        </div>
        <h5 class="fw-bold mb-1">Hi there! 👋</h5>
        <p class="text-muted small mb-4">
          Ask me anything about logging sessions, activities, photos — or anything VEDA related.
        </p>
        <div class="d-flex flex-column gap-2">
          <button
            type="button"
            class="btn btn-light btn-sm text-start px-3 py-2"
            style="border:1px solid #e5d9f5; border-radius:0.75rem;"
            {{on "click" (fn (mut this.inputText) "How do I log a session?")}}
          >
            <i class="fa-solid fa-circle-question me-2 text-primary"></i>How do I log a session?
          </button>
          <button
            type="button"
            class="btn btn-light btn-sm text-start px-3 py-2"
            style="border:1px solid #e5d9f5; border-radius:0.75rem;"
            {{on "click" (fn (mut this.inputText) "What is the Kissflow form and do I need to fill it?")}}
          >
            <i class="fa-solid fa-circle-question me-2 text-primary"></i>What is the Kissflow form?
          </button>
          <button
            type="button"
            class="btn btn-light btn-sm text-start px-3 py-2"
            style="border:1px solid #e5d9f5; border-radius:0.75rem;"
            {{on "click" (fn (mut this.inputText) "Why is my location not being captured?")}}
          >
            <i class="fa-solid fa-circle-question me-2 text-primary"></i>Why is my location not captured?
          </button>
          <button
            type="button"
            class="btn btn-light btn-sm text-start px-3 py-2"
            style="border:1px solid #e5d9f5; border-radius:0.75rem;"
            {{on "click" (fn (mut this.inputText) "What activities can I log for a session?")}}
          >
            <i class="fa-solid fa-circle-question me-2 text-primary"></i>What activities can I log?
          </button>
        </div>
      </div>
    {{/unless}}

    {{! ── Messages ──────────────────────────────────────────────────────────── }}
    {{#each this.messages as |msg|}}
      <div
        class="d-flex mb-3 {{if (eq msg.role 'user') 'justify-content-end' 'justify-content-start'}}"
      >
        {{#unless (eq msg.role 'user')}}
          <div
            class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-2"
            style="width:32px;height:32px;background:linear-gradient(135deg,#7b2fbe,#5a1e82);align-self:flex-end;"
          >
            <i class="fa-solid fa-robot text-white" style="font-size:0.75rem;"></i>
          </div>
        {{/unless}}

        <div
          class="px-3 py-2 small"
          style="
            max-width: 82%;
            border-radius: {{if (eq msg.role 'user') '1rem 1rem 0.25rem 1rem' '1rem 1rem 1rem 0.25rem'}};
            {{if (eq msg.role 'user')
              'background: linear-gradient(135deg,#7b2fbe,#5a1e82); color: #fff;'
              'background: #fff; color: #1c0d2e; box-shadow: 0 2px 8px rgba(90,30,130,0.10); border: 1px solid #ede7f6;'
            }}
          "
        >{{{msg.content}}}</div>
      </div>
    {{/each}}

    {{! ── Loading indicator ────────────────────────────────────────────────── }}
    {{#if this.isLoading}}
      <div class="d-flex justify-content-start mb-3">
        <div
          class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-2"
          style="width:32px;height:32px;background:linear-gradient(135deg,#7b2fbe,#5a1e82);align-self:flex-end;"
        >
          <i class="fa-solid fa-robot text-white" style="font-size:0.75rem;"></i>
        </div>
        <div
          class="px-3 py-2 small"
          style="background:#fff;border:1px solid #ede7f6;border-radius:1rem 1rem 1rem 0.25rem;box-shadow:0 2px 8px rgba(90,30,130,0.10);"
        >
          <span class="spinner-grow spinner-grow-sm me-1" style="color:#7b2fbe;" role="status" aria-hidden="true"></span>
          <span class="spinner-grow spinner-grow-sm me-1" style="color:#7b2fbe;animation-delay:0.15s;" role="status" aria-hidden="true"></span>
          <span class="spinner-grow spinner-grow-sm" style="color:#7b2fbe;animation-delay:0.3s;" role="status" aria-hidden="true"></span>
        </div>
      </div>
    {{/if}}

  </div>

  {{! ── Input bar ──────────────────────────────────────────────────────────── }}
  <div
    class="my-3 p-2"
    style="background:#fff;border:1px solid #ede7f6;border-radius:1rem;box-shadow:0 2px 12px rgba(90,30,130,0.08);"
  >
    <div class="d-flex align-items-end gap-2">
      <textarea
        class="form-control border-0 shadow-none small"
        rows="3"
        placeholder="Ask something about sessions, VEDA…"
        value={{this.inputText}}
        disabled={{this.isLoading}}
        style="resize:none;background:transparent;max-height:120px;overflow-y:auto;padding:0.5rem 0.25rem;"
        {{on "input" this.onInputChange}}
        {{on "keydown" this.onKeyDown}}
      ></textarea>
      <button
        type="button"
        class="btn btn-primary d-flex align-items-center justify-content-center flex-shrink-0"
        style="width:40px;height:40px;border-radius:0.75rem;padding:0;"
        disabled={{or this.isLoading (not this.inputText)}}
        {{on "click" this.sendMessage}}
        aria-label="Send"
      >
        <i class="fa-solid fa-paper-plane" style="font-size:0.85rem;"></i>
      </button>
    </div>
  </div>

</div>

<Footer />

{{outlet}}
