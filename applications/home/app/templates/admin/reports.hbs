{{! app/templates/admin/reports.hbs }}
{{page-title 'Reports — Fazoo Admin'}}

{{! ═══════════════════════════════════════════════════════ Session detail modal }}
<div
  class='modal fade'
  id='sessionModal'
  tabindex='-1'
  aria-labelledby='sessionModalLabel'
  aria-hidden='true'
>
  <div class='modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable'>
    <div class='modal-content border-0 shadow-lg' style='border-radius:1rem;overflow:hidden'>

      {{#if this.selectedSession}}

        {{! ── Slideshow ──────────────────────────────────────────────────────── }}
        <div class='ba-slideshow position-relative' style='min-height:280px'>

          {{#if this.currentSlide}}
            <div class='ba-slide active'>
              {{#if this.isImage}}
                <img
                  src={{this.currentSlide}}
                  alt='Session media'
                  class='ba-slide-media'
                />
              {{else}}
                <video
                  src={{this.currentSlide}}
                  class='ba-slide-media'
                  controls
                  preload='metadata'
                ></video>
              {{/if}}
              <div class='ba-slide-caption px-3 py-1'>
                {{this.currentSlide}}
              </div>
            </div>

            {{! Prev / Next arrows }}
            {{#if (gt this.modalSlides.length 1)}}
              <button
                type='button'
                class='ba-carousel-btn ba-carousel-prev'
                disabled={{eq this.slideIndex 0}}
                {{on 'click' this.prevSlide}}
              >
                <i class='fa-solid fa-chevron-left'></i>
              </button>
              <button
                type='button'
                class='ba-carousel-btn ba-carousel-next'
                disabled={{eq this.slideIndex (sub this.modalSlides.length 1)}}
                {{on 'click' this.nextSlide}}
              >
                <i class='fa-solid fa-chevron-right'></i>
              </button>

              {{! Dot indicators }}
              <div class='ba-carousel-indicators'>
                {{#each this.modalSlides as |_ i|}}
                  <button
                    type='button'
                    class='ba-carousel-dot {{if (eq this.slideIndex i) "active"}}'
                    {{on 'click' (fn this.goToSlide i)}}
                  ></button>
                {{/each}}
              </div>
            {{/if}}

          {{else}}
            {{! No media placeholder }}
            <div class='d-flex flex-column align-items-center justify-content-center h-100 text-white-50 py-5'>
              <i class='fa-solid fa-images fa-3x mb-3'></i>
              <span class='small'>No photos or videos recorded</span>
            </div>
          {{/if}}

          {{! Slide counter badge }}
          {{#if (gt this.modalSlides.length 0)}}
            <span
              class='badge bg-dark position-absolute'
              style='top:10px;right:44px;opacity:0.75;font-size:0.7rem'
            >
              {{add this.slideIndex 1}} / {{this.modalSlides.length}}
            </span>
          {{/if}}

          {{! Close button overlaid on top-right }}
          <button
            type='button'
            class='btn-close btn-close-white position-absolute'
            style='top:10px;right:10px;z-index:20'
            aria-label='Close'
            {{on 'click' this.closeModal}}
          ></button>
        </div>

        {{! ── Session details ────────────────────────────────────────────────── }}
        <div class='modal-body px-4 py-3'>

          {{! Title + status badge }}
          <div class='d-flex align-items-start justify-content-between gap-2 mb-3'>
            <h5 class='fw-bold mb-0' id='sessionModalLabel'>
              {{this.selectedSession.modules.title}}
            </h5>
            <span
              class='badge flex-shrink-0 {{if (eq this.selectedSession.modules.status "cancelled") "bg-danger" "bg-success"}}'
              style='font-size:0.8rem'
            >
              {{this.selectedSession.modules.status}}
            </span>
          </div>

          {{! Detail grid }}
          <div class='row g-3 small'>

            <div class='col-6 col-md-4'>
              <p class='text-muted text-uppercase fw-bold mb-1' style='font-size:0.65rem'>Date</p>
              <p class='mb-0 fw-medium'>{{format-date this.selectedSession.modules.session_date}}</p>
            </div>

            <div class='col-6 col-md-4'>
              <p class='text-muted text-uppercase fw-bold mb-1' style='font-size:0.65rem'>School</p>
              <p class='mb-0 fw-medium'>{{this.selectedSessionSchoolTitle}}</p>
            </div>

            <div class='col-6 col-md-4'>
              <p class='text-muted text-uppercase fw-bold mb-1' style='font-size:0.65rem'>Brand Ambassador</p>
              <p class='mb-0 fw-medium'>{{this.selectedSessionBaTitle}}</p>
            </div>

            <div class='col-6 col-md-4'>
              <p class='text-muted text-uppercase fw-bold mb-1' style='font-size:0.65rem'>Activity</p>
              <p class='mb-0 fw-medium'>{{this.activityLabel}}</p>
            </div>

            <div class='col-6 col-md-4'>
              <p class='text-muted text-uppercase fw-bold mb-1' style='font-size:0.65rem'>Learners</p>
              <p class='mb-0 fw-bold text-success fs-5'>{{this.selectedSessionTotalLearners}}</p>
              {{#if this.selectedSessionLearnerBreakdown.length}}
                <ul class='list-unstyled mb-0 mt-1 small text-muted'>
                  {{#each this.selectedSessionLearnerBreakdown as |entry|}}
                    <li>
                      <span class='fw-medium'>{{entry.title}}:</span>
                      {{entry.count}}
                    </li>
                  {{/each}}
                </ul>
              {{else if this.selectedSessionIsLegacyCounts}}
                <p class='small text-muted mb-0 mt-1 fst-italic'>
                  Combined total (older record)
                </p>
              {{/if}}
            </div>

            <div class='col-6 col-md-4'>
              <p class='text-muted text-uppercase fw-bold mb-1' style='font-size:0.65rem'>Kissflow Confirmed</p>
              <p class='mb-0'>
                {{#if this.selectedSession.modules.kissflow_confirmed}}
                  <span class='badge bg-success'>Yes</span>
                {{else}}
                  <span class='badge bg-secondary'>No</span>
                {{/if}}
              </p>
            </div>

            {{#if (eq this.selectedSession.modules.status 'cancelled')}}
              <div class='col-12'>
                <p class='text-muted text-uppercase fw-bold mb-1' style='font-size:0.65rem'>Cancellation Reason</p>
                <p class='mb-0 text-danger'>{{this.selectedSession.modules.cancellation_reason}}</p>
              </div>
            {{/if}}

            {{#if this.selectedSession.modules.notes}}
              <div class='col-12'>
                <p class='text-muted text-uppercase fw-bold mb-1' style='font-size:0.65rem'>Notes</p>
                <p class='mb-0'>{{this.selectedSession.modules.notes}}</p>
              </div>
            {{/if}}

            {{#if this.selectedSession.modules.checkin_latitude}}
              <div class='col-12'>
                <p class='text-muted text-uppercase fw-bold mb-1' style='font-size:0.65rem'>GPS Check-in</p>
                <p class='mb-0 text-muted font-monospace' style='font-size:0.78rem'>
                  {{this.selectedSession.modules.checkin_latitude}},
                  {{this.selectedSession.modules.checkin_longitude}}
                </p>
              </div>
            {{/if}}

          </div>
        </div>

        <div class='modal-footer border-0 pt-0'>
          <button
            type='button'
            class='btn btn-outline-secondary btn-sm'
            {{on 'click' this.closeModal}}
          >
            Close
          </button>
        </div>

      {{/if}}
    </div>
  </div>
</div>

{{! ═══════════════════════════════════════════════════════════ Main page ══════ }}
<div class='min-vh-100' style='background: #F5F0FA'>

  {{! ── Top navbar ─────────────────────────────────────────────────────────── }}
  <nav class='navbar bg-dark navbar-dark px-4 py-3 shadow-sm'>
    <a class='navbar-brand fw-bold fs-5' href='/admin/reports'>
      <i class='fa-solid fa-chart-bar me-2'></i>FaZoo Admin
    </a>
    <div class='d-flex align-items-center gap-3'>
      <span class='text-light small'>{{this.adminAuth.currentAdmin.modules.title}}</span>
      <button
        type='button'
        class='btn btn-outline-light btn-sm'
        {{on 'click' this.adminAuth.logout}}
      >
        <i class='fa-solid fa-right-from-bracket me-1'></i>Sign Out
      </button>
    </div>
  </nav>

  <div class='container-xl py-4 px-4'>

    {{! ── Page header ─────────────────────────────────────────────────────── }}
    <div class='d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4'>
      <div>
        <h4 class='fw-bold mb-0'>Activation Reports</h4>
        <p class='text-muted small mb-0'>VEDA school sessions overview</p>
      </div>
      <div class='d-flex gap-2'>
        <button
          type='button'
          class='btn btn-success btn-sm fw-bold'
          {{on 'click' this.exportCsv}}
        >
          <i class='fa-solid fa-file-csv me-1'></i>Export CSV
        </button>

        {{! ── Monthly / Weekly / Daily report workbooks (one per month) ──────── }}
        <div class='dropdown'>
          <button
            type='button'
            class='btn btn-primary btn-sm fw-bold dropdown-toggle'
            data-bs-toggle='dropdown'
            aria-expanded='false'
          >
            <i class='fa-solid fa-file-excel me-1'></i>Export Report
          </button>
          <ul class='dropdown-menu dropdown-menu-end'>
            <li>
              <h6 class='dropdown-header'>Monthly / Weekly / Daily</h6>
            </li>
            {{#each this.monthlyReportMonths as |m|}}
              <li>
                <button
                  type='button'
                  class='dropdown-item'
                  {{on 'click' (fn this.exportMonthlyReport m)}}
                >
                  {{m.label}}
                </button>
              </li>
            {{else}}
              <li>
                <span class='dropdown-item-text text-muted small'>No months available</span>
              </li>
            {{/each}}
          </ul>
        </div>
      </div>
    </div>

    {{! ── Date range picker ───────────────────────────────────────────────── }}
    <div class='card mb-4'>
      <div class='card-body py-3'>
        <div class='d-flex flex-wrap align-items-center gap-3'>

          {{! Quick-range buttons }}
          <div class='d-flex gap-2 flex-wrap'>
            <span class='text-muted small align-self-center fw-medium'>Quick:</span>
            <button type='button' class='btn btn-outline-secondary btn-sm' {{on 'click' (fn this.setQuickRange 7)}}>
              Last 7 days
            </button>
            <button type='button' class='btn btn-outline-secondary btn-sm' {{on 'click' (fn this.setQuickRange 30)}}>
              Last 30 days
            </button>
            <button type='button' class='btn btn-outline-secondary btn-sm' {{on 'click' (fn this.setQuickRange 90)}}>
              Last 90 days
            </button>
          </div>

          <div class='vr d-none d-md-block'></div>

          {{! Custom from/to }}
          <div class='d-flex align-items-center gap-2 flex-wrap'>
            <label class='text-muted small fw-medium mb-0'>From</label>
            <input
              type='date'
              class='form-control form-control-sm'
              style='width:160px'
              value={{this.dateFrom}}
              {{on 'change' this.setDateFrom}}
            />
            <label class='text-muted small fw-medium mb-0'>To</label>
            <input
              type='date'
              class='form-control form-control-sm'
              style='width:160px'
              value={{this.dateTo}}
              {{on 'change' this.setDateTo}}
            />
          </div>

          <span class='badge bg-primary rounded-pill ms-auto'>
            {{this.filteredSessions.length}} sessions
          </span>

        </div>
      </div>
    </div>

    {{! ── Image ZIP export ────────────────────────────────────────────────── }}
    <div class='card mb-4'>
      <div class='card-body py-3'>
        <div class='d-flex flex-wrap align-items-center gap-3'>
          <div>
            <p class='fw-bold mb-0'>
              <i class='fa-solid fa-file-zipper me-2 text-primary'></i>Download Session Media
            </p>
            <p class='text-muted small mb-0'>
              Zips every image and video from sessions in the selected range, foldered by date,
              region and school. Large ranges may take a few minutes.
            </p>
          </div>
          <button
            type='button'
            class='btn btn-primary btn-sm fw-bold ms-auto'
            {{on 'click' this.downloadImagesZip}}
          >
            <i class='fa-solid fa-images me-1'></i>Build Media ZIP
          </button>
        </div>

        {{#if this.zipBuilding}}
          <div class='alert alert-info mt-3 mb-0 py-2 px-3 small'>
            <p class='mb-0'>
              <i class='fa-solid fa-spinner fa-spin me-1'></i>
              Building a ZIP of {{this.zipImageCount}} file(s). This will be ready in a few seconds…
            </p>
          </div>
        {{else if this.zipReady}}
          <div class='alert alert-success mt-3 mb-0 py-2 px-3 small'>
            <p class='mb-2'>
              <i class='fa-solid fa-circle-check me-1'></i>
              Your ZIP of {{this.zipImageCount}} file(s) is ready.
            </p>
            <div class='d-flex align-items-center gap-2'>
              <input
                type='text'
                class='form-control form-control-sm font-monospace'
                readonly
                value={{this.zipUrl}}
              />
              <button
                type='button'
                class='btn btn-outline-secondary btn-sm flex-shrink-0'
                {{on 'click' this.copyZipUrl}}
              >
                <i class='fa-solid fa-copy me-1'></i>Copy
              </button>
              <a
                href={{this.zipUrl}}
                class='btn btn-success btn-sm flex-shrink-0'
                target='_blank'
                rel='noopener'
                download
              >
                <i class='fa-solid fa-download me-1'></i>Download
              </a>
            </div>
          </div>
        {{else if (and this.zipAttempted (eq this.zipImageCount 0))}}
          <div class='alert alert-warning mt-3 mb-0 py-2 px-3 small'>
            <i class='fa-solid fa-triangle-exclamation me-1'></i>
            No images or videos found in sessions for this date range.
          </div>
        {{/if}}
      </div>
    </div>

    {{! ── KPI cards ───────────────────────────────────────────────────────── }}
    <div class='row g-3 mb-4'>

      <div class='col-sm-6 col-lg-3'>
        <div class='card h-100'>
          <div class='card-body'>
            <p class='text-muted small mb-1 text-uppercase fw-bold' style='font-size:0.7rem'>Sessions in Range</p>
            <h2 class='fw-bold text-primary mb-0'>{{this.filteredSessions.length}}</h2>
          </div>
        </div>
      </div>

      <div class='col-sm-6 col-lg-3'>
        <div class='card h-100'>
          <div class='card-body'>
            <p class='text-muted small mb-1 text-uppercase fw-bold' style='font-size:0.7rem'>Learners in Range</p>
            <h2 class='fw-bold text-success mb-0'>{{this.totalLearners}}</h2>
          </div>
        </div>
      </div>

      <div class='col-sm-6 col-lg-3'>
        <div class='card h-100'>
          <div class='card-body'>
            <p class='text-muted small mb-1 text-uppercase fw-bold' style='font-size:0.7rem'>Learners This Month</p>
            <h2 class='fw-bold text-info mb-0'>{{this.monthlyLearners}}</h2>
          </div>
        </div>
      </div>

      <div class='col-sm-6 col-lg-3'>
        <div class='card h-100'>
          <div class='card-body'>
            <p class='text-muted small mb-1 text-uppercase fw-bold' style='font-size:0.7rem'>Registered BAs</p>
            <h2 class='fw-bold text-warning mb-0'>{{@model.bas.length}}</h2>
          </div>
        </div>
      </div>

    </div>

    {{! ── Map + Sessions table ────────────────────────────────────────────── }}
    <div class='row g-4 mb-4'>

      {{! ── Mapbox map }}
      <div class='col-lg-6'>
        <div class='card h-100'>
          <div class='card-header bg-white fw-bold border-bottom py-3 d-flex align-items-center justify-content-between'>
            <span><i class='fa-solid fa-map-location-dot me-2 text-primary'></i>Session Locations</span>
            <span class='badge bg-primary rounded-pill'>{{this.mappableSessions.length}} pins</span>
          </div>
          <div class='card-body p-0 overflow-hidden' style='border-radius: 0 0 0.5rem 0.5rem'>
            <div
              style='height: 440px; width: 100%'
              {{mapbox-sessions this.mappableSessions onSelect=this.openSession}}
            ></div>
          </div>
          <div class='card-footer bg-white py-2 px-3 d-flex gap-3'>
            <small class='text-muted'>
              <span class='d-inline-block rounded-circle me-1' style='width:10px;height:10px;background:#22C55E'></span>
              Completed
            </small>
            <small class='text-muted'>
              <span class='d-inline-block rounded-circle me-1' style='width:10px;height:10px;background:#EF4444'></span>
              Cancelled
            </small>
            <small class='text-muted ms-auto'>
              <i class='fa-solid fa-hand-pointer me-1'></i>Click a pin for details
            </small>
          </div>
        </div>
      </div>

      {{! ── Sessions table }}
      <div class='col-lg-6'>
        <div class='card h-100'>
          <div class='card-header bg-white fw-bold border-bottom py-3'>
            Sessions in Range
          </div>
          <div class='card-body p-0' style='overflow-y: auto; max-height: 480px'>
            {{#if this.filteredSessions.length}}
              <table class='table table-hover mb-0 align-middle small'>
                <thead class='table-light sticky-top'>
                  <tr>
                    <th>Date</th>
                    <th>School</th>
                    <th>Activity</th>
                    <th class='text-center'>Learners</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each this.filteredSessionsDecorated as |row|}}
                    <tr
                      style='cursor:pointer'
                      {{on 'click' (fn this.openSession row.raw)}}
                    >
                      <td class='text-nowrap'>{{format-date row.raw.modules.session_date}}</td>
                      <td>{{row.raw.modules.title}}</td>
                      <td>
                        {{#if (eq row.raw.modules.activity_type 'crayon_colouring')}}Crayon Colouring
                        {{else if (eq row.raw.modules.activity_type 'watercolour_painting')}}Watercolour Painting
                        {{else if (eq row.raw.modules.activity_type 'paper_crafts')}}Paper Crafts
                        {{else}}{{row.raw.modules.activity_type}}{{/if}}
                      </td>
                      <td class='text-center'>
                        <div class='fw-bold'>{{row.total}}</div>
                        {{#if row.breakdown.length}}
                          <div class='small text-muted' style='font-size:0.7rem'>
                            {{#each row.breakdown as |entry i|}}
                              {{if i ' · '}}{{entry.short}}
                              {{entry.count}}
                            {{/each}}
                          </div>
                        {{/if}}
                      </td>
                      <td>
                        <span class='badge {{if (eq row.raw.modules.status "cancelled") "bg-danger" "bg-success"}}'>
                          {{row.raw.modules.status}}
                        </span>
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
                <tfoot class='table-light'>
                  <tr>
                    <td colspan='3' class='fw-bold text-end'>Total</td>
                    <td class='text-center fw-bold text-success'>{{this.totalLearners}}</td>
                    <td></td>
                  </tr>
                </tfoot>
              </table>
            {{else}}
              <div class='text-center py-5 text-muted'>
                <i class='fa-solid fa-calendar-xmark fa-2x mb-2 d-block'></i>
                No sessions for this date range.
              </div>
            {{/if}}
          </div>
        </div>
      </div>

    </div>

    {{! ── Learners by school ──────────────────────────────────────────────── }}
    <div class='card mb-4'>
      <div class='card-header bg-white fw-bold border-bottom py-3'>
        Learners by School — in Range
      </div>
      <div class='card-body p-0'>
        {{#if this.filteredSessions.length}}
          <table class='table table-hover mb-0 small'>
            <thead class='table-light'>
              <tr>
                <th>Session</th>
                <th class='text-center'>Learners</th>
                <th>Activity</th>
                <th>Date</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {{#each this.filteredSessionsDecorated as |row|}}
                <tr style='cursor:pointer' {{on 'click' (fn this.openSession row.raw)}}>
                  <td class='fw-medium'>{{row.raw.modules.title}}</td>
                  <td class='text-center'>
                    <div class='fw-bold'>{{row.total}}</div>
                    {{#if row.breakdown.length}}
                      <div class='small text-muted' style='font-size:0.7rem'>
                        {{#each row.breakdown as |entry i|}}
                          {{if i ' · '}}{{entry.short}}
                          {{entry.count}}
                        {{/each}}
                      </div>
                    {{/if}}
                  </td>
                  <td>
                    {{#if (eq row.raw.modules.activity_type 'crayon_colouring')}}Crayon Colouring
                    {{else if (eq row.raw.modules.activity_type 'watercolour_painting')}}Watercolour Painting
                    {{else if (eq row.raw.modules.activity_type 'paper_crafts')}}Paper Crafts
                    {{else}}{{row.raw.modules.activity_type}}{{/if}}
                  </td>
                  <td class='text-nowrap'>{{format-date row.raw.modules.session_date}}</td>
                  <td>
                    <span class='badge {{if (eq row.raw.modules.status "cancelled") "bg-danger" "bg-success"}}'>
                      {{row.raw.modules.status}}
                    </span>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        {{else}}
          <p class='text-muted text-center py-4 mb-0'>No data for this period.</p>
        {{/if}}
      </div>
    </div>

    {{! ── All BAs ─────────────────────────────────────────────────────────── }}
    <div class='card'>
      <div class='card-header bg-white fw-bold border-bottom py-3'>
        All BAs ({{@model.bas.length}})
      </div>
      <div class='card-body p-0'>
        <table class='table table-hover mb-0 small'>
          <thead class='table-light'>
            <tr>
              <th>Name</th>
              <th>Phone</th>
              <th class='text-center'>Sessions in Range</th>
              <th class='text-center'>Status</th>
            </tr>
          </thead>
          <tbody>
            {{#each @model.bas as |ba|}}
              {{#let (filter-by-ba this.filteredSessions ba.id) as |baSessions|}}
                <tr>
                  <td class='fw-medium'>{{ba.modules.title}}</td>
                  <td class='text-muted'>{{ba.modules.phone}}</td>
                  <td class='text-center'>{{baSessions.length}}</td>
                  <td class='text-center'>
                    {{#if (eq baSessions.length 0)}}
                      <span class='badge bg-warning text-dark'>Inactive</span>
                    {{else}}
                      <span class='badge bg-success'>Active</span>
                    {{/if}}
                  </td>
                </tr>
              {{/let}}
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>
