{{!
  <LenovoFooter>

  Bottom navigation for the Lenovo BA app. Visible on every signed-in
  Lenovo screen via the parent `lenovo` template. Three primary
  destinations: Home, Sales, Check-Out.
}}

{{#if this.lenovoSessionAuth.isAuthenticated}}
  <nav
    class="navbar navbar-light bg-white border-top fixed-bottom"
    style="box-shadow: 0 -2px 12px rgba(90, 30, 130, 0.08);"
  >
    <div class="container-fluid px-2">
      <div class="d-flex w-100 justify-content-around">

        <LinkTo
          @route="lenovo.index"
          class="btn btn-link text-decoration-none text-center d-flex align-items-center justify-content-center flex-column px-2 py-1
            {{if
              (this.isActive 'lenovo.index')
              'text-primary fw-bold'
              'text-muted'
            }}"
        >
          <i class="fa-solid fa-house d-block fs-5"></i>
          <small>Home</small>
        </LinkTo>

        <LinkTo
          @route="lenovo.sales"
          class="btn btn-link text-decoration-none text-center d-flex align-items-center justify-content-center flex-column px-2 py-1
            {{if
              (this.isActive 'lenovo.sales')
              'text-primary fw-bold'
              'text-muted'
            }}"
        >
          <i class="fa-solid fa-calculator d-block fs-5"></i>
          <small>Sales</small>
        </LinkTo>

        <LinkTo
          @route="lenovo.checkout"
          class="btn btn-link text-decoration-none text-center d-flex align-items-center justify-content-center flex-column px-2 py-1
            {{if
              (this.isActive 'lenovo.checkout')
              'text-primary fw-bold'
              'text-muted'
            }}"
        >
          <i class="fa-solid fa-flag-checkered d-block fs-5"></i>
          <small>Day End</small>
        </LinkTo>

      </div>
    </div>
  </nav>
{{/if}}
