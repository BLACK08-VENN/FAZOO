{{!
  <LenovoCheckinForm>

  Args:
    @stores        {Array}    — list of lenovo_store records for the dropdown
    @onSave        {Function} — receives the form-data object on submit
    @isSaving      {boolean}  — disables submit and shows a spinner
    @errorMessage  {string}   — external error from the parent
}}

<div class="container-fluid px-3 pt-4 pb-5">

  {{! ── Page header ───────────────────────────────────────────────────────── }}
  <div class="d-flex align-items-center mb-3">
    <a href="/lenovo" class="btn btn-link text-muted ps-0 me-2">
      <i class="fa-solid fa-arrow-left"></i>
    </a>
    <h2 class="fw-bold mb-0">Daily Check-In</h2>
  </div>

  {{! ── External error ────────────────────────────────────────────────────── }}
  {{#if @errorMessage}}
    <div
      class="alert alert-danger py-2 small"
      role="alert"
    >{{@errorMessage}}</div>
  {{/if}}

  {{! ── Step indicator ────────────────────────────────────────────────────── }}
  <div class="d-flex justify-content-between align-items-center mb-4">
    {{! Step 1 }}
    <div class="flex-fill text-center">
      <div
        class="rounded-circle mx-auto d-flex align-items-center justify-content-center fw-bold
          {{if
            (gte this.step 1)
            'bg-primary text-white'
            'bg-light text-muted border'
          }}"
        style="width: 36px; height: 36px;"
      >1</div>
      <small
        class="d-block mt-1 small
          {{if (eq this.step 1) 'fw-bold text-primary' 'text-muted'}}"
      >
        Reported
      </small>
    </div>
    <div
      class="flex-shrink-0"
      style="width: 24px; height: 2px; margin: 0 4px; align-self:flex-start; margin-top:18px; background:{{if
        (gte this.step 2)
        '#7B2FBE'
        '#dee2e6'
      }};"
    ></div>

    {{! Step 2 }}
    <div class="flex-fill text-center">
      <div
        class="rounded-circle mx-auto d-flex align-items-center justify-content-center fw-bold
          {{if
            (gte this.step 2)
            'bg-primary text-white'
            'bg-light text-muted border'
          }}"
        style="width: 36px; height: 36px;"
      >2</div>
      <small
        class="d-block mt-1 small
          {{if (eq this.step 2) 'fw-bold text-primary' 'text-muted'}}"
      >
        Stock
      </small>
    </div>
    <div
      class="flex-shrink-0"
      style="width: 24px; height: 2px; margin: 0 4px; align-self:flex-start; margin-top:18px; background:{{if
        (gte this.step 3)
        '#7B2FBE'
        '#dee2e6'
      }};"
    ></div>

    {{! Step 3 }}
    <div class="flex-fill text-center">
      <div
        class="rounded-circle mx-auto d-flex align-items-center justify-content-center fw-bold
          {{if
            (gte this.step 3)
            'bg-primary text-white'
            'bg-light text-muted border'
          }}"
        style="width: 36px; height: 36px;"
      >3</div>
      <small
        class="d-block mt-1 small
          {{if (eq this.step 3) 'fw-bold text-primary' 'text-muted'}}"
      >
        Selfie
      </small>
    </div>
  </div>

  {{! ════════════════════════════════════════ }}
  {{! ── STEP 1: I have reported ── }}
  {{! ════════════════════════════════════════ }}
  {{#if (eq this.step 1)}}
    <div class="card mb-3">
      <div class="px-0 card-body">
        <h5 class="fw-bold mb-2">Step 1 — I have reported</h5>
        <p class="text-muted small mb-3">
          Pick the store you're reporting at, then capture your check-in
          location.
        </p>

        {{! ── Store picker (mandatory) ────────────────────────────────── }}
        <div class="mb-3">
          <label class="form-label fw-medium">Store
            <span class="text-danger">*</span></label>
          <div class="form-control p-0 border-0">
            <PowerSelect
              @options={{@stores}}
              @selected={{this.selectedStore}}
              @onChange={{this.onStoreChange}}
              @searchEnabled={{true}}
              @searchField="modules.title"
              @searchPlaceholder="Type to search stores…"
              @placeholder="Pick a store…"
              @noMatchesMessage="No stores found"
              as |store|
            >
              <span
                class="d-block fw-medium lh-sm"
              >{{store.modules.title}}</span>
              {{#if store.modules.promoter}}
                <small class="d-block text-muted lh-sm">
                  <i
                    class="fa-solid fa-circle me-1"
                  ></i>{{store.modules.promoter}}
                </small>
              {{/if}}
            </PowerSelect>
          </div>
        </div>

        {{! ── Location capture ────────────────────────────────────────── }}
        {{#if this.locationError}}
          <div class="alert alert-danger py-2 small" role="alert">
            <i
              class="fa-solid fa-circle-exclamation me-1"
            ></i>{{this.locationError}}
          </div>
        {{/if}}

        {{#if this.hasLocation}}
          <div class="alert alert-success py-2 small mb-3">
            <i class="fa-solid fa-circle-check me-1"></i>
            Location captured.
          </div>

          {{! Mapbox preview of the captured point }}
          <div
            class="rounded-2 overflow-hidden mb-2 border"
            style="height: 200px;"
            {{checkin-map this.checkinLatitude this.checkinLongitude}}
          ></div>

          <div class="form-text mb-3">
            <i class="fa-solid fa-location-dot me-1 text-primary"></i>
            {{this.checkinLatitude}},
            {{this.checkinLongitude}}
          </div>
          <button
            type="button"
            class="btn btn-outline-secondary btn-sm"
            {{on "click" this.captureLocation}}
          >
            <i class="fa-solid fa-rotate-right me-1"></i>Re-capture
          </button>
        {{else}}
          <button
            type="button"
            class="btn btn-primary btn-lg w-100 fw-bold"
            disabled={{this.isLocating}}
            {{on "click" this.captureLocation}}
          >
            {{#if this.isLocating}}
              <span class="spinner-border spinner-border-sm me-2"></span>Getting
              location…
            {{else}}
              <i class="fa-solid fa-location-crosshairs me-2"></i>I Have
              Reported
            {{/if}}
          </button>
          <div class="form-text text-muted mt-2 small">
            <i class="fa-solid fa-circle-info me-1"></i>
            Your browser will ask for location permission. Please allow it.
          </div>
        {{/if}}
      </div>
    </div>

    <div class="d-grid">
      <button
        type="button"
        class="btn btn-primary btn-lg fw-bold"
        disabled={{not this.canAdvanceFromStep1}}
        {{on "click" this.nextStep}}
      >
        Next: Stock Photo
        <i class="fa-solid fa-arrow-right ms-2"></i>
      </button>
    </div>
  {{/if}}

  {{! ════════════════════════════════════════ }}
  {{! ── STEP 2: Stock on shelf ── }}
  {{! ════════════════════════════════════════ }}
  {{#if (eq this.step 2)}}
    <div class="card mb-3">
      <div class="px-0 card-body">
        <h5 class="fw-bold mb-2">Step 2 — Stock on shelf</h5>
        <p class="text-muted small mb-3">
          Take a clear photo of the Lenovo stock currently on the shelf at this
          store.
        </p>

        {{#if this.stockUploadError}}
          <div class="alert alert-danger py-2 small" role="alert">
            <i
              class="fa-solid fa-circle-exclamation me-1"
            ></i>{{this.stockUploadError}}
          </div>
        {{/if}}

        <div
          class="rounded-2 border border-2 d-flex flex-column align-items-center justify-content-center p-3 text-center"
          style="border-color: #c4aee8 !important; border-style: dashed !important; cursor: pointer; min-height: 180px; background: #faf7ff;"
          {{on "click" this.triggerStockInput}}
        >
          {{#if this.isUploadingStock}}
            <span
              class="spinner-border text-primary mb-2"
              role="status"
              aria-hidden="true"
            ></span>
            <small class="text-muted">Uploading…</small>
          {{else if this.stockPhotoPreview}}
            <img
              src={{this.stockPhotoPreview}}
              alt="Stock preview"
              class="rounded-2 mb-2 object-fit-contain"
              style="max-width: 100%; max-height: 220px;"
            />
            {{#if this.stockPhotoUrl}}
              <small class="text-success mt-1"><i
                  class="fa-solid fa-circle-check me-1"
                ></i>Uploaded</small>
            {{/if}}
            <small class="text-primary mt-1" style="cursor:pointer">Retake /
              change</small>
          {{else}}
            <i class="fa-solid fa-camera fa-2x text-primary mb-2"></i>
            <span class="fw-medium text-dark small">Tap to take a stock photo</span>
            <small class="text-muted">JPG or PNG</small>
          {{/if}}
        </div>
        <input
          type="file"
          accept="image/jpeg,image/png"
          capture="environment"
          class="d-none"
          id="lenovoStockPhotoInput"
          disabled={{this.isUploadingStock}}
          {{on "change" this.onStockPhotoSelected}}
        />
      </div>
    </div>

    <div class="d-flex gap-2">
      <button
        type="button"
        class="btn btn-outline-secondary btn-lg flex-fill fw-bold"
        {{on "click" this.prevStep}}
      >
        <i class="fa-solid fa-arrow-left me-2"></i>Back
      </button>
      <button
        type="button"
        class="btn btn-primary btn-lg flex-fill fw-bold"
        disabled={{not this.canAdvanceFromStep2}}
        {{on "click" this.nextStep}}
      >
        Next
        <i class="fa-solid fa-arrow-right ms-2"></i>
      </button>
    </div>
  {{/if}}

  {{! ════════════════════════════════════════ }}
  {{! ── STEP 3: Selfie in uniform ── }}
  {{! ════════════════════════════════════════ }}
  {{#if (eq this.step 3)}}
    <div class="card mb-3">
      <div class="px-0 card-body">
        <h5 class="fw-bold mb-2">Step 3 — Photo in uniform</h5>
        <p class="text-muted small mb-3">
          Take a clear selfie of yourself wearing your Lenovo uniform.
        </p>

        {{#if this.uniformUploadError}}
          <div class="alert alert-danger py-2 small" role="alert">
            <i
              class="fa-solid fa-circle-exclamation me-1"
            ></i>{{this.uniformUploadError}}
          </div>
        {{/if}}

        <div
          class="rounded-2 border border-2 d-flex flex-column align-items-center justify-content-center p-3 text-center"
          style="border-color: #c4aee8 !important; border-style: dashed !important; cursor: pointer; min-height: 180px; background: #faf7ff;"
          {{on "click" this.triggerUniformInput}}
        >
          {{#if this.isUploadingUniform}}
            <span
              class="spinner-border text-primary mb-2"
              role="status"
              aria-hidden="true"
            ></span>
            <small class="text-muted">Uploading…</small>
          {{else if this.uniformPhotoPreview}}
            <img
              src={{this.uniformPhotoPreview}}
              alt="Uniform selfie preview"
              class="rounded-2 mb-2 object-fit-contain"
              style="max-width: 100%; max-height: 220px;"
            />
            {{#if this.uniformPhotoUrl}}
              <small class="text-success mt-1"><i
                  class="fa-solid fa-circle-check me-1"
                ></i>Uploaded</small>
            {{/if}}
            <small class="text-primary mt-1" style="cursor:pointer">Retake /
              change</small>
          {{else}}
            <i class="fa-solid fa-user-tie fa-2x text-primary mb-2"></i>
            <span class="fw-medium text-dark small">Tap to take a uniform selfie</span>
            <small class="text-muted">JPG or PNG</small>
          {{/if}}
        </div>
        <input
          type="file"
          accept="image/jpeg,image/png"
          capture="user"
          class="d-none"
          id="lenovoUniformPhotoInput"
          disabled={{this.isUploadingUniform}}
          {{on "change" this.onUniformPhotoSelected}}
        />

        {{! Optional notes }}
        <div class="mt-3">
          <label class="form-label fw-medium small">Notes (optional)</label>
          <textarea
            class="form-control"
            rows="2"
            placeholder="Anything notable about today?"
            value={{this.notes}}
            {{on "input" this.onNotesChange}}
          ></textarea>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2">
      <button
        type="button"
        class="btn btn-outline-secondary btn-lg flex-fill fw-bold"
        {{on "click" this.prevStep}}
      >
        <i class="fa-solid fa-arrow-left me-2"></i>Back
      </button>
      <button
        type="button"
        class="btn btn-primary btn-lg flex-fill fw-bold"
        disabled={{or (not this.canSubmit) @isSaving}}
        {{on "click" this.handleSubmit}}
      >
        {{#if @isSaving}}
          <span class="spinner-border spinner-border-sm me-2"></span>Saving…
        {{else}}
          <i class="fa-solid fa-circle-check me-2"></i>Submit Check-In
        {{/if}}
      </button>
    </div>
  {{/if}}

</div>
