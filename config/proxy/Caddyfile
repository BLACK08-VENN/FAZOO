# ./config/proxy/Caddyfile
# Central reverse proxy — handles HTTPS/TLS for all subdomains

{
    email {$CONTACT_EMAIL:hq@wildfire.world}
    admin off
}

tribe.fazoo.setarez.com {
    reverse_proxy {$PROJECT_NAME}_caddy_tribe:80

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer-when-downgrade"
    }

    log {
        output file /var/log/caddy/proxy_tribe_access.log {
            roll_size 100MiB
            roll_keep 5
            roll_keep_for 24h
        }
        format json
        level INFO
    }
}

